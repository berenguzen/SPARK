# Classic FizzBuzz, written in Spark.
# Prints numbers 1 to 20, but:
#  - multiples of 3 -> "Fizz"
#  - multiples of 5 -> "Buzz"
#  - multiples of both -> "FizzBuzz"

func is_divisible(n, by) {
    return n - (by * int(n / by)) == 0
}

let i = 1
while i <= 20 {
    if is_divisible(i, 15) {
        print("FizzBuzz")
    } else {
        if is_divisible(i, 3) {
            print("Fizz")
        } else {
            if is_divisible(i, 5) {
                print("Buzz")
            } else {
                print(i)
            }
        }
    }
    i = i + 1
}